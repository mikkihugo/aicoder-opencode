#!/usr/bin/env bash
set -euo pipefail

# Canonical source: /home/mhugo/code/aicoder-opencode/.opencode/bin/aicoder-maintenance-autonomous-start
# Edit shared maintenance logic here first, then mirror to target runtime copies.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
MAINTENANCE_WEB_SERVICE_NAME="${AICODER_MAINTENANCE_SERVICE_NAME:-aicoder-opencode-main.service}"
MAINTENANCE_SERVER_URL="${AICODER_MAINTENANCE_SERVER_URL:-http://127.0.0.1:8080}"
MAINTENANCE_AUTOMATION_USERNAME="${AICODER_MAINTENANCE_AUTOMATION_USERNAME:-opencode}"
MAINTENANCE_PASSWORD_PATH="${AICODER_MAINTENANCE_PASSWORD_PATH:-$REPO_ROOT/.opencode/state/maintenance-web/server-password}"
LOG_DIRECTORY="$REPO_ROOT/.opencode/state/autopilot"
LOG_PATH="$LOG_DIRECTORY/maintenance-autonomous-start.log"
START_MESSAGE_TEMPLATE=$(cat <<'PROMPT'
Maintenance iteration for aicoder-opencode. Follow this workflow strictly:
1. Consult roadmap_keeper for the next highest-value slice (read STATUS.md, ROADMAP.md, active plans, recent checkpoints).
2. If the slice is straightforward, reversible, and local, read the repo evidence and implement it directly. Do not open helper branches just to satisfy process.
3. Only when the slice is ambiguous, risky, or crosses boundaries, pick exactly one supportive helper for the current blind spot. Default to planning_analyst. Use consumer_advocate only for user-visible workflow or unsafe-default questions. Use codebase_explorer or architecture_consultant only when ownership or structure is unclear.
4. If you opened a supportive helper, run exactly one adversarial helper in parallel with it. Default to critical_reviewer. Use oracle or security_reviewer only when the slice specifically needs that pressure.
5. If you spawned branches, write a parent synthesis note with USED:, DISCARDED:, and NEXT: before spawning any more branches. Do not dispatch a second planner/reviewer round until that synthesis exists.
6. Implement the change yourself, or delegate one tightly scoped implementation_worker task with exact paths, exact change, and one-sentence why. At most one writer branch at a time.
7. Run verifier after changes. If regression or security risk is material, run critical_reviewer or security_reviewer as an additional read-only pass.
8. Commit when verified. Loop to step 1 for the next slice. Never ask the user unless the next move is destructive or irreversible; otherwise record the assumption in the checkpoint and continue.
9. Keep the session title and checkpoints clean and specific to aicoder control-plane work.
10. **PDD Purpose gate — emit BEFORE any edit.** For every non-trivial slice, emit the 6-line Purpose block (OBSERVED: / PURPOSE: / WHY: / IF/THEN: / CONFIDENCE: 0.0-1.0 / GATE:) as specified in implementation_lead.md BEFORE touching code. Trivial reversible slices may emit a one-line RATIONALE: instead. CONFIDENCE < 0.7 blocks proceeding without an adversarial subagent pass (critical_reviewer / oracle / security_reviewer). This is how we enforce the review gate visibly in transcripts.
11. **Subagent output guard.** If any dispatched specialist returns zero text (step-start + step-finish with no content parts), treat it as a failed MCP 503 dispatch, NOT as no feedback. Retry with a different-lineage model. If a branch emits only tool traces or no explicit conclusion, treat it as unusable in the same way. Never synthesize on empty input. Record reviewer=empty, retried=MODEL in slice notes.
12. **Stale-session salvage is read-only first.** If an older or stale root contains edits, checkpoints, or reviewer output, salvage the artifact/blocker into the current live root and compare it against current repo state before editing. Never reopen or overwrite a newer live slice unless repo evidence shows the stale work is still unresolved.
13. **Read-only specialists must not write.** `planning_analyst`, `roadmap_keeper`, `consumer_advocate`, `codebase_explorer`, `architecture_consultant`, `critical_reviewer`, `security_reviewer`, `verifier`, `documentation_researcher`, `long_context_reader`, `reliability_consultant`, and `oracle` are evidence-only. If any of them emits a patch or file delta, treat it as invalid, discard it, record the violation in the checkpoint, and continue only through `implementation_lead`, `implementation_worker`, or `small_change_worker`.

Spec-kit is the canonical scaffold: shape every non-trivial slice as /specify (spec from .specify/templates/spec-template.md) -> /plan (plan from plan-template.md) -> /tasks (tasks from tasks-template.md) -> /implement. PM skills (pm-outcome-roadmap, pm-create-prd, pm-brainstorm-okrs, pm-prioritization-frameworks, pm-pre-mortem) feed the spec; planning_analyst feeds the plan; implementation_lead executes tasks.
PROMPT
)
START_MESSAGE="${1:-$START_MESSAGE_TEMPLATE}"
AUTONOMOUS_SESSION_TITLE="${AICODER_MAINTENANCE_AUTONOMOUS_SESSION_TITLE:-aicoder-opencode}"
SESSION_ID_FILE="$LOG_DIRECTORY/maintenance-autonomous-session-id"
AGENT_NAME="${AICODER_MAINTENANCE_AGENT_NAME:-implementation_lead}"
ACTIVE_RUN_STALE_SECONDS="${AICODER_ACTIVE_RUN_STALE_SECONDS:-1200}"
GENERIC_MAINTENANCE_TITLE_REGEX="${AICODER_MAINTENANCE_GENERIC_TITLE_REGEX:-\`?aicoder-maintenance\`?|\`?aicoder-control-plane\`?|\`?aicoder-opencode\`?|\`?aicoder-opencode maintenance\`?|\`?aicoder-opencode / main / control-plane\`?}"

wait_for_remote_server() {
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" <<'PY'
import base64, sys, time, urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
request = urllib.request.Request(f"{server_url}/session")
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

deadline = time.time() + 30
last_error = None
while time.time() < deadline:
    try:
        with urllib.request.urlopen(request, timeout=2):
            sys.exit(0)
    except Exception as exc:
        last_error = exc
        time.sleep(1)
raise SystemExit(f"aicoder-maintenance: shared server not ready: {last_error}")
PY
}

list_remote_sessions() {
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" <<'PY'
import base64, sys, urllib.request
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session?directory={quote(repo_root, safe='/')}")
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")
with urllib.request.urlopen(request, timeout=5) as response:
    print(response.read().decode("utf-8"))
PY
}

delete_remote_session() {
  local session_id="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" <<'PY'
import base64, sys, urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session/{session_id}", method="DELETE")
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")
with urllib.request.urlopen(request, timeout=5):
    pass
PY
}

rename_remote_session() {
  local session_id="$1"
  local session_title="$2"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" "$session_title" <<'PY'
import base64, json, sys, urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
session_title = sys.argv[5]
request = urllib.request.Request(
    f"{server_url}/session/{session_id}",
    data=json.dumps({"title": session_title}).encode(),
    method="PATCH",
)
request.add_header("Content-Type", "application/json")
request.add_header("Accept", "application/json")
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")
with urllib.request.urlopen(request, timeout=5):
    pass
PY
}

archive_remote_session() {
  local session_id="$1"
  local session_title="$2"
  rename_remote_session "$session_id" "[STALE] ${session_title} — ${session_id}"
}

create_remote_session() {
  local session_title="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" "$session_title" <<'PY'
import base64, json, sys, urllib.request
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
session_title = sys.argv[5]
body = json.dumps({"title": session_title}).encode()
request = urllib.request.Request(
    f"{server_url}/session?directory={quote(repo_root, safe='/')}",
    data=body,
    method="POST",
)
request.add_header("Content-Type", "application/json")
request.add_header("Accept", "application/json")
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")
with urllib.request.urlopen(request, timeout=30) as response:
    payload = json.loads(response.read().decode("utf-8"))
    print(payload["id"])
PY
}

send_remote_prompt() {
  local session_id="$1"
  local agent_name="$2"
  local prompt_text="$3"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" "$session_id" "$agent_name" "$prompt_text" <<'PY'
import base64, json, sys, urllib.request
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
session_id = sys.argv[5]
agent_name = sys.argv[6]
prompt_text = sys.argv[7]
body = {"agent": agent_name, "parts": [{"type": "text", "text": prompt_text}]}

request = urllib.request.Request(
    f"{server_url}/session/{quote(session_id, safe='')}/message?directory={quote(repo_root, safe='/')}",
    data=json.dumps(body).encode(),
    method="POST",
)
request.add_header("Content-Type", "application/json")
request.add_header("Accept", "application/json")
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

with urllib.request.urlopen(request, timeout=30) as response:
    print(json.dumps({
        "accepted": True,
        "status": response.status,
        "sessionID": session_id,
        "agent": agent_name,
    }))
PY
}

session_has_active_assistant_run() {
  local session_id="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" <<'PY'
import base64, json, sys, urllib.error, urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session/{session_id}/message")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        messages = json.loads(response.read().decode("utf-8"))
except urllib.error.URLError:
    raise SystemExit(1)

for message in reversed(messages):
    info = message.get("info") or {}
    if info.get("role") != "assistant":
        continue

    finish = info.get("finish")
    if isinstance(finish, str) and finish:
        raise SystemExit(1)

    print("assistant-active")
    raise SystemExit(0)

raise SystemExit(1)
PY
}

session_has_blocked_assistant_run() {
  local session_id="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" <<'PY'
import base64, json, sys, urllib.error, urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]

request = urllib.request.Request(f"{server_url}/session/{session_id}/message")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode()).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        messages = json.loads(response.read().decode("utf-8"))
except urllib.error.URLError:
    raise SystemExit(1)

last_assistant = None
for message in reversed(messages):
    info = message.get("info") or {}
    if info.get("role") == "assistant":
        last_assistant = (message, info)
        break

if not last_assistant:
    raise SystemExit(1)

message, info = last_assistant
if info.get("finish"):
    raise SystemExit(1)

parts = message.get("parts")
if not isinstance(parts, list):
    parts = info.get("parts")
if not isinstance(parts, list):
    parts = []


def _is_empty_pending_tool(part):
    if not isinstance(part, dict):
        return False
    if part.get("type") != "tool":
        return False
    if str(part.get("status", "")).lower() != "pending":
        return False
    arguments = part.get("input") or part.get("arguments") or part.get("args") or part.get("parameters") or part.get("payload")
    if arguments is None:
        return True
    if isinstance(arguments, str):
        return not arguments.strip()
    if isinstance(arguments, (list, tuple, dict)):
        return len(arguments) == 0
    return False


def _has_substantive_content(part):
    if not isinstance(part, dict):
        return False
    part_type = str(part.get("type", "")).lower()
    if part_type in {"step-start", "step-finish"}:
        return False
    for key in ("text", "content", "message", "output", "result", "diff", "body", "error"):
        value = part.get(key)
        if isinstance(value, str) and value.strip():
            return True
        if isinstance(value, (list, dict)) and value:
            return True
    if part_type == "tool":
        status = str(part.get("status", "")).lower()
        if status and status != "pending":
            return bool(part.get("result")) or bool(part.get("output"))
        arguments = part.get("input") or part.get("arguments") or part.get("args") or part.get("parameters") or part.get("payload")
        if isinstance(arguments, str):
            return bool(arguments.strip())
        if arguments:
            return True
    return False

is_empty_pending_tool = any(_is_empty_pending_tool(part) for part in parts)
has_substantive_content = any(_has_substantive_content(part) for part in parts)

  if not parts or not has_substantive_content or (is_empty_pending_tool and not has_substantive_content):
    print("assistant-blocked")
    raise SystemExit(0)

raise SystemExit(1)
PY
}

session_has_stale_assistant_run() {
  local session_id="$1"
  local stale_after_seconds="$2"
  # Heartbeat-based staleness: an assistant run is stale only when the last
  # assistant message has no finish marker AND the session-level time.updated
  # hasn't advanced for stale_after_seconds. opencode bumps time.updated on
  # every part write, so a genuinely long-running tool call stays alive as
  # long as it keeps streaming — we no longer kill 25-min real work just
  # because the message was *created* 20 min ago. Falls back to
  # info.time.created if time.updated is missing.
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" "$stale_after_seconds" "$REPO_ROOT" <<'PY'
import base64, json, sys, time, urllib.error, urllib.request
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
stale_after_seconds = int(sys.argv[5])
repo_root = sys.argv[6]

def _auth(req):
    if password_path.exists():
        pw = password_path.read_text(encoding="utf-8").strip()
        if pw:
            token = base64.b64encode(f"{username}:{pw}".encode()).decode("ascii")
            req.add_header("Authorization", f"Basic {token}")

message_req = urllib.request.Request(f"{server_url}/session/{session_id}/message")
_auth(message_req)
try:
    with urllib.request.urlopen(message_req, timeout=30) as response:
        messages = json.loads(response.read().decode("utf-8"))
except urllib.error.URLError:
    raise SystemExit(1)

last_assistant = None
for message in reversed(messages):
    info = message.get("info") or {}
    if info.get("role") == "assistant":
        last_assistant = info
        break

if not last_assistant:
    raise SystemExit(1)

finish = last_assistant.get("finish")
if isinstance(finish, str) and finish:
    raise SystemExit(1)

session_updated_ms = None
sessions = []
this_session = None
session_req = urllib.request.Request(
    f"{server_url}/session?directory={quote(repo_root, safe='/')}"
)
_auth(session_req)
try:
    with urllib.request.urlopen(session_req, timeout=30) as response:
        sessions = json.loads(response.read().decode("utf-8"))
    for session in sessions:
        if session.get("id") == session_id:
            this_session = session
            session_updated_ms = (session.get("time") or {}).get("updated")
            break
except urllib.error.URLError:
    session_updated_ms = None

summary = (this_session or {}).get("summary") or {}
has_code_artifact = any(
    isinstance(summary.get(field_name), (int, float)) and summary.get(field_name) > 0
    for field_name in ("files", "additions", "deletions")
)
if has_code_artifact:
    raise SystemExit(1)

child_heartbeat_ms = 0
for sibling_session in sessions:
    if sibling_session.get("parentID") != session_id:
        continue
    sibling_time = sibling_session.get("time") or {}
    sibling_updated = sibling_time.get("updated")
    sibling_created = sibling_time.get("created")
    if isinstance(sibling_updated, (int, float)):
        child_heartbeat_ms = max(child_heartbeat_ms, int(sibling_updated))
    elif isinstance(sibling_created, (int, float)):
        child_heartbeat_ms = max(child_heartbeat_ms, int(sibling_created))

if isinstance(session_updated_ms, (int, float)):
    heartbeat_ms = int(session_updated_ms)
else:
    created = (last_assistant.get("time") or {}).get("created")
    heartbeat_ms = int(created) if isinstance(created, (int, float)) else 0

now_ms = int(time.time() * 1000)
if child_heartbeat_ms > 0 and now_ms - child_heartbeat_ms < stale_after_seconds * 1000:
    raise SystemExit(1)

if heartbeat_ms > 0 and now_ms - heartbeat_ms >= stale_after_seconds * 1000:
    print("assistant-stale")
    raise SystemExit(0)

raise SystemExit(1)
PY
}

mkdir -p "$LOG_DIRECTORY"
touch "$LOG_PATH"
exec >>"$LOG_PATH" 2>&1
echo "[$(date -Iseconds)] aicoder-maintenance: bootstrap start"
systemctl --user start "$MAINTENANCE_WEB_SERVICE_NAME" >/dev/null
wait_for_remote_server >/dev/null
REMOTE_SESSIONS_JSON="$(list_remote_sessions)"

SESSION_SELECTION_JSON="$(python3 - "$REMOTE_SESSIONS_JSON" "$AUTONOMOUS_SESSION_TITLE" "$GENERIC_MAINTENANCE_TITLE_REGEX" "$REPO_ROOT" <<'PY'
import json, re, sys

sessions = json.loads(sys.argv[1]) if sys.argv[1].strip() else []
title = sys.argv[2]
generic_title_regex = re.compile(sys.argv[3], re.IGNORECASE)
repo_root = sys.argv[4]
matching = [
    s for s in sessions
    if str(s.get("title", "")) == title and str(s.get("directory", "")) == repo_root
]
matching.sort(key=lambda item: int(item.get("time", {}).get("updated", 0)), reverse=True)
generic_conflicts = [
    s["id"]
    for s in sessions
    if str(s.get("directory", "")) == repo_root
    and str(s.get("title", "")) != title
    and generic_title_regex.search(str(s.get("title", "")))
]
print(json.dumps({
    "matching": [s["id"] for s in matching],
    "genericConflicts": generic_conflicts,
}))
PY
)"

CANDIDATE_SESSION_IDS="$(python3 - "$SESSION_SELECTION_JSON" <<'PY'
import json, sys

selection = json.loads(sys.argv[1])
for session_id in selection.get("matching", []):
    print(session_id)
PY
)"

GENERIC_CONFLICT_SESSION_IDS="$(python3 - "$SESSION_SELECTION_JSON" <<'PY'
import json, sys

selection = json.loads(sys.argv[1])
for session_id in selection.get("genericConflicts", []):
    print(session_id)
PY
)"

cleanup_session_ids_except_selected() {
  local session_ids="${1:-}"
  local selected_session_id="${2:-}"
  if [[ -z "$session_ids" ]]; then
    return
  fi

  while IFS= read -r session_id; do
    [[ -z "$session_id" ]] && continue
    [[ "$session_id" == "$selected_session_id" ]] && continue
    archive_remote_session "$session_id" "$AUTONOMOUS_SESSION_TITLE"
  done <<<"$session_ids"
}

SELECTED_SESSION_ID=""
if [[ -n "$CANDIDATE_SESSION_IDS" ]]; then
  while IFS= read -r session_id; do
    [[ -z "$session_id" ]] && continue
    if session_has_active_assistant_run "$session_id"; then
      SELECTED_SESSION_ID="$session_id"
      break
    fi
    if [[ -z "$SELECTED_SESSION_ID" ]]; then
      SELECTED_SESSION_ID="$session_id"
    fi
  done <<<"$CANDIDATE_SESSION_IDS"
fi

cleanup_session_ids_except_selected "$GENERIC_CONFLICT_SESSION_IDS" "$SELECTED_SESSION_ID"

if [[ -z "$SELECTED_SESSION_ID" ]]; then
  SELECTED_SESSION_ID="$(create_remote_session "$AUTONOMOUS_SESSION_TITLE")"
fi

if [[ -n "$SELECTED_SESSION_ID" ]]; then
  if session_has_blocked_assistant_run "$SELECTED_SESSION_ID"; then
    echo "[$(date -Iseconds)] aicoder-maintenance: resuming blocked session $SELECTED_SESSION_ID"
  elif session_has_stale_assistant_run "$SELECTED_SESSION_ID" "$ACTIVE_RUN_STALE_SECONDS"; then
    echo "[$(date -Iseconds)] aicoder-maintenance: resuming stale session $SELECTED_SESSION_ID"
  elif session_has_active_assistant_run "$SELECTED_SESSION_ID"; then
    echo "[$(date -Iseconds)] aicoder-maintenance: assistant still running in session $SELECTED_SESSION_ID"
    printf '%s\n' "$SELECTED_SESSION_ID" >"$SESSION_ID_FILE"
    echo "aicoder-maintenance: active run already in progress on $MAINTENANCE_SERVER_URL"
    exit 0
  fi
fi

if [[ -z "$SELECTED_SESSION_ID" ]]; then
  SELECTED_SESSION_ID="$(create_remote_session "$AUTONOMOUS_SESSION_TITLE")"
fi

if [[ -z "$SELECTED_SESSION_ID" ]]; then
  echo "[$(date -Iseconds)] aicoder-maintenance: failed to select or create a session"
  exit 1
fi

printf '%s\n' "$SELECTED_SESSION_ID" >"$SESSION_ID_FILE"

echo "[$(date -Iseconds)] aicoder-maintenance: prompting session $SELECTED_SESSION_ID via $MAINTENANCE_SERVER_URL"
PROMPT_RESULT="$(send_remote_prompt "$SELECTED_SESSION_ID" "$AGENT_NAME" "$START_MESSAGE")"
