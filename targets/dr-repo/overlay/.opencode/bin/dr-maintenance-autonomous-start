#!/usr/bin/env bash
set -euo pipefail

# Canonical source: /home/mhugo/code/aicoder-opencode/targets/dr-repo/overlay/.opencode/bin/dr-maintenance-autonomous-start
# Edit the control-plane copy first, then mirror here.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
AUTOPILOT_BIN="$REPO_ROOT/.opencode/bin/dr-autopilot"
MAINTENANCE_WEB_SERVICE_NAME="${DR_REPO_MAINTENANCE_SERVICE_NAME:-aicoder-opencode-main.service}"
MAINTENANCE_SERVER_URL="${DR_REPO_MAINTENANCE_SERVER_URL:-${DR_MAINTENANCE_SERVER_URL:-http://127.0.0.1:8080}}"
MAINTENANCE_AUTOMATION_USERNAME="${DR_REPO_MAINTENANCE_AUTOMATION_USERNAME:-${DR_MAINTENANCE_AUTOMATION_USERNAME:-opencode}}"
MAINTENANCE_PASSWORD_PATH="${DR_REPO_MAINTENANCE_PASSWORD_PATH:-$REPO_ROOT/.opencode/state/maintenance-web/server-password}"
LOG_DIRECTORY="$REPO_ROOT/.opencode/state/autopilot"
LOG_PATH="$LOG_DIRECTORY/maintenance-autonomous-start.log"
START_MESSAGE_TEMPLATE=$(cat <<'PROMPT'
Maintenance iteration for dr-repo. Follow this workflow strictly:
1. Consult roadmap_keeper for the next highest-value slice (read STATUS.md, ROADMAP.md, active plans under docs/plans/, recent checkpoints).
2. If the slice is straightforward, reversible, and local, read the repo evidence and implement it directly. Do not open helper branches just to satisfy process.
3. Only when the slice is ambiguous, risky, or crosses boundaries, pick exactly one supportive helper for the current blind spot. Default to planning_analyst. Use consumer_advocate only for user-visible workflow or unsafe-default questions. Use codebase_explorer or architecture_consultant only when ownership or structure is unclear.
4. If you opened a supportive helper, run exactly one adversarial helper in parallel with it. Default to critical_reviewer. Use oracle or security_reviewer only when the slice specifically needs that pressure.
5. If you spawned branches, write a parent synthesis note with USED:, DISCARDED:, and NEXT: before spawning any more branches. Do not dispatch a second planner/reviewer round until that synthesis exists.
6. Implement the change yourself, or delegate one tightly scoped implementation_worker task with exact paths, exact change, and one-sentence why. At most one writer branch at a time.
7. Run verifier after changes. If regression or security risk is material, run critical_reviewer or security_reviewer as an additional read-only pass.
8. Commit when verified. Loop to step 1 for the next slice. Never ask the user unless the next move is destructive or irreversible; otherwise record the assumption in the checkpoint and continue.
9. Keep the session title and checkpoints clean and specific to dr-repo delivery work.
10. **PDD Purpose gate — emit BEFORE any edit.** For every non-trivial slice, emit the 6-line Purpose block (OBSERVED: / PURPOSE: / WHY: / IF/THEN: / CONFIDENCE: 0.0-1.0 / GATE:) as specified in implementation_lead.md BEFORE touching code. Trivial reversible slices may emit a one-line RATIONALE: instead. CONFIDENCE < 0.7 blocks proceeding without an adversarial subagent pass (critical_reviewer / oracle / security_reviewer). The Purpose block is your visible proof the gate was run.
11. **Subagent output guard.** If any dispatched specialist returns zero text (step-start + step-finish with no content parts), treat it as a failed MCP 503 dispatch, NOT as no feedback. Retry with a different-lineage model. If a branch emits only tool traces or no explicit conclusion, treat it as unusable in the same way. Never synthesize on empty input. Record reviewer=empty, retried=MODEL in slice notes.
12. **Stale-session salvage is read-only first.** If an older or stale root contains edits, checkpoints, or reviewer output, salvage the artifact/blocker into the current live root and compare it against current repo state before editing. Never reopen or overwrite a newer live slice unless repo evidence shows the stale work is still unresolved.
13. **Read-only specialists must not write.** `planning_analyst`, `roadmap_keeper`, `consumer_advocate`, `codebase_explorer`, `architecture_consultant`, `critical_reviewer`, `security_reviewer`, `verifier`, `documentation_researcher`, `long_context_reader`, `reliability_consultant`, and `oracle` are evidence-only. If any of them emits a patch or file delta, treat it as invalid, discard it, record the violation in the checkpoint, and continue only through `implementation_lead`, `implementation_worker`, or `small_change_worker`.

Spec-kit is the canonical scaffold: shape every non-trivial slice as /specify (spec from .specify/templates/spec-template.md) -> /plan (plan from plan-template.md) -> /tasks (tasks from tasks-template.md) -> /implement. PM skills (pm-outcome-roadmap, pm-create-prd, pm-brainstorm-okrs, pm-prioritization-frameworks, pm-pre-mortem) feed the spec; planning_analyst feeds the plan; implementation_lead executes tasks.
PROMPT
)
START_MESSAGE="${1:-$START_MESSAGE_TEMPLATE}"
AUTONOMOUS_SESSION_TITLE="${DR_REPO_MAINTENANCE_AUTONOMOUS_SESSION_TITLE:-${DR_MAINTENANCE_AUTONOMOUS_SESSION_TITLE:-dr-repo}}"
GENERIC_AUTONOMOUS_TITLE_REGEX="${DR_REPO_MAINTENANCE_GENERIC_AUTONOMOUS_TITLE_REGEX:-${DR_MAINTENANCE_GENERIC_AUTONOMOUS_TITLE_REGEX:-dr-maintenance-autonomous|dr[- ]repo maintenance|dr[- ]repo delivery|dr[- ]repo / main / delivery|dr[- ]repo / main / product|^dr-repo$|autonomous iteration|dr autonomous iteration mode}}"
SESSION_ID_FILE="$LOG_DIRECTORY/maintenance-autonomous-session-id"
RUNNER_UNIT_NAME="${DR_REPO_MAINTENANCE_RUNNER_UNIT_NAME:-dr-repo-maintenance-run.service}"
REMOTE_MESSAGE_READ_TIMEOUT_SECONDS="${DR_REPO_REMOTE_MESSAGE_READ_TIMEOUT_SECONDS:-120}"
ACTIVE_RUN_STALE_SECONDS="${DR_REPO_ACTIVE_RUN_STALE_SECONDS:-1200}"

list_remote_sessions() {
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" <<'PY'
import base64
import json
import sys
import urllib.request
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session?directory={quote(repo_root, safe='/')}")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

with urllib.request.urlopen(request, timeout=5) as response:
    payload = response.read().decode("utf-8")
    print(payload)
PY
}

delete_remote_session() {
  local session_id="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" <<'PY'
import base64
import sys
import urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session/{session_id}", method="DELETE")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

with urllib.request.urlopen(request, timeout=5):
    pass
PY
}

wait_for_remote_server() {
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" <<'PY'
import base64
import sys
import time
import urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
request = urllib.request.Request(f"{server_url}/session")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

deadline = time.time() + 30
last_error = None
while time.time() < deadline:
    try:
        with urllib.request.urlopen(request, timeout=2):
            sys.exit(0)
    except Exception as exc:
        last_error = exc
        time.sleep(1)

raise SystemExit(f"dr-maintenance-autonomous: shared server not ready: {last_error}")
PY
}

write_autonomous_checkpoint() {
  local session_id="$1"
  python3 - "$REPO_ROOT" "$session_id" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

repo_root = sys.argv[1]
session_id = sys.argv[2]
checkpoint_dir = os.path.join(repo_root, ".opencode", "state", "checkpoints")
checkpoint_path = os.path.join(checkpoint_dir, f"{session_id}.json")
os.makedirs(checkpoint_dir, exist_ok=True)

existing = {"sessionID": session_id}
if os.path.exists(checkpoint_path):
    with open(checkpoint_path, "r", encoding="utf-8") as handle:
        existing = json.load(handle)

existing["sessionID"] = session_id
existing["autonomousIteration"] = True
existing["status"] = existing.get("status") or "in_progress"
existing["updatedAt"] = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")

with open(checkpoint_path, "w", encoding="utf-8") as handle:
    json.dump(existing, handle, indent=2)
    handle.write("\n")
PY
}

create_remote_session() {
  local session_title="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" "$session_title" <<'PY'
import base64
import json
import sys
import urllib.request
import urllib.error
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
session_title = sys.argv[5]
body = json.dumps({"title": session_title}).encode("utf-8")
request = urllib.request.Request(
    f"{server_url}/session?directory={quote(repo_root, safe='/')}",
    data=body,
    method="POST",
)
request.add_header("Content-Type", "application/json")
request.add_header("Accept", "application/json")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

with urllib.request.urlopen(request, timeout=30) as response:
    payload = json.loads(response.read().decode("utf-8"))
    print(payload["id"])
PY
}

session_requires_rotation() {
  local session_id="$1"
  local expected_agent="$2"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" "$expected_agent" <<'PY'
import base64
import json
import sys
import urllib.request
import urllib.error
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
expected_agent = sys.argv[5]
request = urllib.request.Request(f"{server_url}/session/{session_id}/message")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        messages = json.loads(response.read().decode("utf-8"))
except urllib.error.URLError:
    print("missing-session")
    raise SystemExit(0)

if not messages:
    print("empty-session")
    raise SystemExit(0)

for message in messages:
    info = message.get("info") or {}
    if info.get("role") != "user":
        continue

    agent_name = info.get("agent")
    if isinstance(agent_name, str) and agent_name and agent_name != expected_agent:
        print("foreign-agent")
        raise SystemExit(0)

raise SystemExit(1)
PY
}

session_has_active_assistant_run() {
  local session_id="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" <<'PY'
import base64
import json
import sys
import urllib.request
import urllib.error
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session/{session_id}/message")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        messages = json.loads(response.read().decode("utf-8"))
except urllib.error.URLError:
    raise SystemExit(1)

for message in reversed(messages):
    info = message.get("info") or {}
    if info.get("role") != "assistant":
        continue

    finish = info.get("finish")
    if isinstance(finish, str) and finish:
        raise SystemExit(1)

    print("assistant-active")
    raise SystemExit(0)

raise SystemExit(1)
PY
}

session_has_blocked_assistant_run() {
  local session_id="$1"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$session_id" <<'PY'
import base64
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
session_id = sys.argv[4]
request = urllib.request.Request(f"{server_url}/session/{session_id}/message")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

try:
    with urllib.request.urlopen(request, timeout=30) as response:
        messages = json.loads(response.read().decode("utf-8"))
except urllib.error.URLError:
    raise SystemExit(1)

last_assistant = None
for message in reversed(messages):
    info = message.get("info") or {}
    if info.get("role") == "assistant":
        last_assistant = (message, info)
        break

if not last_assistant:
    raise SystemExit(1)

message, info = last_assistant
if info.get("finish"):
    raise SystemExit(1)

parts = message.get("parts")
if not isinstance(parts, list):
    parts = info.get("parts")
if not isinstance(parts, list):
    parts = []


def _is_empty_pending_tool(part):
    if not isinstance(part, dict):
        return False
    if part.get("type") != "tool":
        return False
    if str(part.get("status", "")).lower() != "pending":
        return False
    arguments = part.get("input") or part.get("arguments") or part.get("args") or part.get("parameters") or part.get("payload")
    if arguments is None:
        return True
    if isinstance(arguments, str):
        return not arguments.strip()
    if isinstance(arguments, (list, tuple, dict)):
        return len(arguments) == 0
    return False


def _has_substantive_content(part):
    if not isinstance(part, dict):
        return False
    part_type = str(part.get("type", "")).lower()
    if part_type in {"step-start", "step-finish"}:
        return False
    for key in ("text", "content", "message", "output", "result", "diff", "body", "error"):
        value = part.get(key)
        if isinstance(value, str) and value.strip():
            return True
        if isinstance(value, (list, dict)) and value:
            return True
    if part_type == "tool":
        status = str(part.get("status", "")).lower()
        if status and status != "pending":
            return bool(part.get("result")) or bool(part.get("output"))
        arguments = part.get("input") or part.get("arguments") or part.get("args") or part.get("parameters") or part.get("payload")
        if isinstance(arguments, str):
            return bool(arguments.strip())
        if arguments:
            return True
    return False

is_empty_pending_tool = any(_is_empty_pending_tool(part) for part in parts)
has_substantive_content = any(_has_substantive_content(part) for part in parts)

if not parts or (is_empty_pending_tool and not has_substantive_content):
    print("assistant-blocked")
    raise SystemExit(0)

raise SystemExit(1)
PY
}

session_has_stale_assistant_run() {
  # Heartbeat-based staleness: an assistant run is stale only if (a) the last
  # assistant message has no finish marker AND (b) the session-level time.updated
  # hasn't advanced for `stale_after_seconds`. Because opencode bumps time.updated
  # on every message/part write, a genuinely long-running (25 min) tool call stays
  # alive as long as it keeps streaming — we no longer kill real work just because
  # the message was *created* long ago.
  local session_id="$1"
  local stale_after_seconds="$2"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" "$session_id" "$stale_after_seconds" <<'PY'
import base64
import json
import sys
import time
import urllib.request
import urllib.error
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
session_id = sys.argv[5]
stale_after_seconds = int(sys.argv[6])

auth_header = None
if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        auth_header = f"Basic {token}"


def fetch_json(path):
    request = urllib.request.Request(f"{server_url}{path}")
    if auth_header is not None:
        request.add_header("Authorization", auth_header)
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


try:
    messages = fetch_json(f"/session/{session_id}/message")
except urllib.error.URLError:
    raise SystemExit(1)

last_assistant = None
for message in reversed(messages):
    info = message.get("info") or {}
    if info.get("role") != "assistant":
        continue
    last_assistant = info
    break

if last_assistant is None:
    raise SystemExit(1)

finish = last_assistant.get("finish")
if isinstance(finish, str) and finish:
    raise SystemExit(1)

# An unfinished assistant run exists. Keep the root alive while it still has accepted artifacts or fresh child-session heartbeat.
try:
    sessions = fetch_json(f"/session?directory={quote(repo_root, safe='/')}")
except urllib.error.URLError:
    raise SystemExit(1)

this_session = next((s for s in sessions if s.get("id") == session_id), None)
if this_session is None:
    raise SystemExit(1)

summary = (this_session.get("summary") or {})
has_code_artifact = any(
    isinstance(summary.get(field_name), (int, float)) and summary.get(field_name) > 0
    for field_name in ("files", "additions", "deletions")
)
if has_code_artifact:
    raise SystemExit(1)

child_heartbeat_ms = 0
for sibling_session in sessions:
    if sibling_session.get("parentID") != session_id:
        continue
    sibling_time = sibling_session.get("time") or {}
    sibling_updated = sibling_time.get("updated")
    sibling_created = sibling_time.get("created")
    if isinstance(sibling_updated, (int, float)):
        child_heartbeat_ms = max(child_heartbeat_ms, int(sibling_updated))
    elif isinstance(sibling_created, (int, float)):
        child_heartbeat_ms = max(child_heartbeat_ms, int(sibling_created))

updated_ms = (this_session.get("time") or {}).get("updated")
if not isinstance(updated_ms, (int, float)):
    # No heartbeat signal available — fall back to message created time so we
    # never silently pass; belt-and-braces against server shape drift.
    created_ms = (last_assistant.get("time") or {}).get("created")
    if not isinstance(created_ms, (int, float)):
        raise SystemExit(1)
    updated_ms = created_ms

now_ms = int(time.time() * 1000)
if child_heartbeat_ms > 0 and now_ms - child_heartbeat_ms < stale_after_seconds * 1000:
    raise SystemExit(1)

if now_ms - int(updated_ms) >= stale_after_seconds * 1000:
    print("assistant-stale")
    raise SystemExit(0)

raise SystemExit(1)
PY
}

send_remote_prompt() {
  local session_id="$1"
  local agent_name="$2"
  local prompt_text="$3"
  python3 - "$MAINTENANCE_SERVER_URL" "$MAINTENANCE_AUTOMATION_USERNAME" "$MAINTENANCE_PASSWORD_PATH" "$REPO_ROOT" "$session_id" "$agent_name" "$prompt_text" "$REMOTE_MESSAGE_READ_TIMEOUT_SECONDS" <<'PY'
import base64
import http.client
import json
import sys
import urllib.request
from pathlib import Path
from urllib.parse import quote

server_url = sys.argv[1].rstrip("/")
username = sys.argv[2]
password_path = Path(sys.argv[3])
repo_root = sys.argv[4]
session_id = sys.argv[5]
agent_name = sys.argv[6]
prompt_text = sys.argv[7]
body = {
    "agent": agent_name,
    "parts": [
        {
            "type": "text",
            "text": prompt_text,
        }
    ],
}

request = urllib.request.Request(
    f"{server_url}/session/{quote(session_id, safe='')}/message?directory={quote(repo_root, safe='/')}",
    data=json.dumps(body).encode("utf-8"),
    method="POST",
)
request.add_header("Content-Type", "application/json")
request.add_header("Accept", "application/json")

if password_path.exists():
    password = password_path.read_text(encoding="utf-8").strip()
    if password:
        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
        request.add_header("Authorization", f"Basic {token}")

with urllib.request.urlopen(request, timeout=30) as response:
    print(
        json.dumps(
            {
                "accepted": True,
                "status": response.status,
                "sessionID": session_id,
                "agent": agent_name,
            }
        )
    )
PY
}

stop_legacy_runner() {
  systemctl --user stop "$RUNNER_UNIT_NAME" >/dev/null 2>&1 || true
}

mkdir -p "$LOG_DIRECTORY"
touch "$LOG_PATH"
exec >>"$LOG_PATH" 2>&1
echo "[$(date -Iseconds)] dr-repo-maintenance: bootstrap start"
systemctl --user start "$MAINTENANCE_WEB_SERVICE_NAME" >/dev/null
"$AUTOPILOT_BIN" start >/dev/null
wait_for_remote_server >/dev/null
REMOTE_SESSIONS_JSON="$(list_remote_sessions)"

SESSION_SELECTION_JSON="$(python3 - "$REMOTE_SESSIONS_JSON" "$AUTONOMOUS_SESSION_TITLE" "$GENERIC_AUTONOMOUS_TITLE_REGEX" "$REPO_ROOT" <<'PY'
import json
import re
import sys

sessions = json.loads(sys.argv[1]) if sys.argv[1].strip() else []
session_title = sys.argv[2]
generic_autonomous_title_regex = re.compile(sys.argv[3], re.IGNORECASE)
repo_root = sys.argv[4]
matching_sessions = [
    session
    for session in sessions
    if str(session.get("title", "")) == session_title
    and str(session.get("directory", "")) == repo_root
]
matching_sessions.sort(key=lambda item: int(item.get("time", {}).get("updated", 0)), reverse=True)
selected = matching_sessions[0]["id"] if matching_sessions else ""
duplicates = [session["id"] for session in matching_sessions[1:]]
generic_conflicts = [
    session["id"]
    for session in sessions
    if str(session.get("directory", "")) == repo_root
    if str(session.get("title", "")) != session_title
    and generic_autonomous_title_regex.search(str(session.get("title", "")))
]
print(json.dumps({"selected": selected, "duplicates": duplicates, "genericConflicts": generic_conflicts}))
PY
)"

SELECTED_SESSION_ID="$(python3 - "$SESSION_SELECTION_JSON" <<'PY'
import json
import sys

selection = json.loads(sys.argv[1])
print(selection.get("selected", ""))
PY
)"

GENERIC_CONFLICT_SESSION_IDS="$(python3 - "$SESSION_SELECTION_JSON" <<'PY'
import json
import sys

selection = json.loads(sys.argv[1])
for session_id in selection.get("genericConflicts", []):
    print(session_id)
PY
)"

cleanup_session_ids() {
  local session_ids="${1:-}"
  if [[ -z "$session_ids" ]]; then
    return
  fi

  while IFS= read -r session_id; do
    if [[ -z "$session_id" ]]; then
      continue
    fi
    delete_remote_session "$session_id"
  done <<<"$session_ids"
}

cleanup_session_ids "$GENERIC_CONFLICT_SESSION_IDS"

if [[ -n "$SELECTED_SESSION_ID" ]]; then
  if session_requires_rotation "$SELECTED_SESSION_ID" "implementation_lead"; then
    echo "[$(date -Iseconds)] dr-repo-maintenance: rotating polluted session $SELECTED_SESSION_ID"
    delete_remote_session "$SELECTED_SESSION_ID"
    SELECTED_SESSION_ID=""
  fi
fi

if [[ -n "$SELECTED_SESSION_ID" ]]; then
  if session_has_blocked_assistant_run "$SELECTED_SESSION_ID"; then
    echo "[$(date -Iseconds)] dr-repo-maintenance: resuming blocked session $SELECTED_SESSION_ID"
  elif session_has_stale_assistant_run "$SELECTED_SESSION_ID" "$ACTIVE_RUN_STALE_SECONDS"; then
    echo "[$(date -Iseconds)] dr-repo-maintenance: resuming stale session $SELECTED_SESSION_ID"
  elif session_has_active_assistant_run "$SELECTED_SESSION_ID"; then
    echo "[$(date -Iseconds)] dr-repo-maintenance: assistant still running in session $SELECTED_SESSION_ID"
    printf '%s\n' "$SELECTED_SESSION_ID" >"$SESSION_ID_FILE"
    write_autonomous_checkpoint "$SELECTED_SESSION_ID"
    echo "dr-repo-maintenance: active run already in progress on $MAINTENANCE_SERVER_URL"
    exit 0
  fi
fi

if [[ -z "$SELECTED_SESSION_ID" ]]; then
  SELECTED_SESSION_ID="$(create_remote_session "$AUTONOMOUS_SESSION_TITLE")"
fi

printf '%s\n' "$SELECTED_SESSION_ID" >"$SESSION_ID_FILE"
write_autonomous_checkpoint "$SELECTED_SESSION_ID"

stop_legacy_runner
echo "[$(date -Iseconds)] dr-repo-maintenance: prompting session $SELECTED_SESSION_ID via $MAINTENANCE_SERVER_URL"
PROMPT_RESULT="$(send_remote_prompt "$SELECTED_SESSION_ID" "implementation_lead" "$START_MESSAGE")"
echo "[$(date -Iseconds)] dr-repo-maintenance: prompt completed $PROMPT_RESULT"

echo "dr-repo-maintenance: seeded via $MAINTENANCE_SERVER_URL"
echo "log: $LOG_PATH"
